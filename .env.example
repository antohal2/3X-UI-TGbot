# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=123456789,987654321

# 3X-UI Panel
XUI_HOST=https://your-panel.example.com:2053
XUI_USERNAME=admin
XUI_PASSWORD=your_password
XUI_INBOUND_ID=1
XUI_TLS_VERIFY=true

# Подписки
SUBSCRIPTION_BASE_URL=https://your-panel.example.com:2096/sub/

# Тарифы (в Telegram Stars)
TRIAL_DURATION_DAYS=1
TRIAL_TRAFFIC_GB=1
TRIAL_DEVICE_LIMIT=1

MONTHLY_PRICE_STARS=50
MONTHLY_DURATION_DAYS=30
MONTHLY_TRAFFIC_GB=0
MONTHLY_DEVICE_LIMIT=2

# База данных
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
